---
interface Props {
  title?: string;
}

const { title = 'ARGENTO WebApp' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      :root {
        --bg: #0a0a0a;
        --panel: #131313;
        --border: #2a2a2a;
        --text: #f4f4f5;
        --muted: #a1a1aa;
        --accent: #22c55e;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: Inter, system-ui, sans-serif;
        background: radial-gradient(circle at top right, #1a1a1a, #090909 45%);
        color: var(--text);
      }
      .panel {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 14px;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
